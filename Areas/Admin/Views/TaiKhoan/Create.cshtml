@model DoAn.Models.tblTaiKhoan
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2 class="text-success">
            <i class="bi bi-person-plus-fill"></i> Thêm tài khoản
        </h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"> Tổng quan</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index"> Quản lý tài khoản</a>
                </li>
                <li class="breadcrumb-item active">Thêm mới</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <form asp-action="Create" method="post">

                    <div class="row">
                        <div
                            class="col-md-4 text-center border-end d-flex flex-column justify-content-center align-items-center">

                            <img id="previewImg" src="~/img/@Model?.TK_AnhDaiDien"
                                 class="img-fluid rounded shadow-sm mb-2" style="max-height:180px;" />
                            <label class="form-label d-block fw-bold">Ảnh đại diện</label>
                            <select class="form-control" asp-for="TK_AnhDaiDien" onchange="previewImage()">
                                <option value="">-- Chọn ảnh --</option>
                                @foreach (var img in ViewBag.Images)
                                {
                                    <option value="@img">@img</option>
                                }
                            </select>
                            <span asp-validation-for="TK_AnhDaiDien" class="text-danger"></span>

                        </div>

                        <div class="col-md-8">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tên đăng nhập</label>
                                    <input asp-for="TK_TenDangNhap" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Họ tên</label>
                                    <input asp-for="TK_HoTen" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Mật khẩu</label>
                                    <input asp-for="TK_MatKhau" type="password" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Điện thoại</label>
                                    <input asp-for="TK_DienThoai" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email</label>
                                    <input asp-for="TK_Email" type="email" class="form-control" required />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Vai trò</label>
                                    <select asp-for="TK_VaiTro" class="form-control">
                                        <option value="admin">Admin</option>
                                        <option value="ChuTro">Chủ tro</option>
                                        <option value="NguoiThue">Người thuê</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Trạng thái</label>
                                    <select asp-for="TK_TrangThai" class="form-control">
                                        <option value="true">Hoạt động</option>
                                        <option value="false">Bị khóa</option>
                                    </select>
                                </div>

                            </div>

                            <div class="mt-4 text-end">
                                <a asp-action="Index" class="btn btn-secondary me-2">
                                    <i class="bi bi-arrow-left"></i> Quay lại
                                </a>

                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-plus-circle"></i> Tạo tài khoản
                                </button>
                            </div>

                        </div>

                    </div>

                </form>

            </div>
        </div>
    </section>
</main>

<script>
    function previewImage() {
        var select = document.querySelector("select[name='TK_AnhDaiDien']");
        var img = document.getElementById("previewImg");

        if (select.value) {
            img.src = "/img/" + select.value;
        }
    }
</script>