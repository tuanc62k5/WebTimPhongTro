@model DoAn.Models.tblTaiKhoan

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Cập nhật tài khoản";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2 class="text-primary">
            <i class="bi bi-pencil-square"></i> Chỉnh sửa tài khoản
        </h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"> Tổng quan</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index"> Quản lý tài khoản</a>
                </li>
                <li class="breadcrumb-item active">Chỉnh sửa</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <form asp-area="Admin" asp-controller="TaiKhoan" asp-action="Edit" asp-route-id="@Model.TK_ID"
                    method="post">
                    @Html.AntiForgeryToken()

                    <input type="hidden" asp-for="TK_ID" />

                    <div class="row">

                        <div class="col-md-4 text-center border-end
                            d-flex flex-column justify-content-center align-items-center">

                            <img id="previewImg" src="@(string.IsNullOrEmpty(Model.TK_AnhDaiDien)
                                    ? "/img/default-avatar.png" : "/img/" + Model.TK_AnhDaiDien)"
                                    class="img-fluid rounded shadow-sm mb-3"
                                style="max-height:180px; max-width:180px; object-fit:cover;" alt="Ảnh đại diện" />

                            <label class="form-label fw-bold">Ảnh đại diện</label>

                            <select class="form-select" asp-for="TK_AnhDaiDien" onchange="previewImage()">

                                <option value="">-- Chọn ảnh --</option>

                                @foreach (var img in (ViewBag.Images as IEnumerable<string>
                                    ?? Enumerable.Empty<string>()))
                                {
                                    <option value="@img">@img</option>
                                }
                            </select>

                            <span asp-validation-for="TK_AnhDaiDien" class="text-danger"></span>
                        </div>

                        <div class="col-md-8">
                            <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Tên đăng nhập</label>
                                    <input asp-for="TK_TenDangNhap" class="form-control" />
                                    <span asp-validation-for="TK_TenDangNhap" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Họ và tên</label>
                                    <input asp-for="TK_HoTen" class="form-control" />
                                    <span asp-validation-for="TK_HoTen" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Email</label>
                                    <input asp-for="TK_Email" type="email" class="form-control" />
                                    <span asp-validation-for="TK_Email" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Điện thoại</label>
                                    <input asp-for="TK_DienThoai" class="form-control" />
                                    <span asp-validation-for="TK_DienThoai" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Mật khẩu mới</label>
                                    <input asp-for="TK_MatKhau" type="password" class="form-control"
                                           placeholder="Để trống nếu không đổi mật khẩu" />
                                    <span asp-validation-for="TK_MatKhau" class="text-danger"></span>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Vai trò</label>
                                    <select asp-for="TK_VaiTro" class="form-select">
                                        <option value="Admin">Quản trị viên</option>
                                        <option value="ChuTro">Chủ trọ</option>
                                        <option value="NguoiThue">Người thuê</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Trạng thái</label>
                                    <select asp-for="TK_TrangThai" class="form-select">
                                        <option value="true">Hoạt động</option>
                                        <option value="false">Bị khóa</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label fw-bold">Ngày tạo</label>
                                    <input class="form-control" value="@Model.TK_NgayTao.ToString("dd/MM/yyyy HH:mm")"
                                           disabled />
                                </div>

                            </div>

                            <div class="mt-4 text-end">

                                <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index"
                                    class="btn btn-secondary me-2">
                                    <i class="bi bi-arrow-left"></i> Quay lại
                                </a>

                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> Lưu thay đổi
                                </button>

                            </div>
                        </div>
                    </div>
                </form>

            </div>
        </div>
    </section>
</main>

<script>
    function previewImage() {
        var select = document.querySelector("select[name='TK_AnhDaiDien']");
        var img = document.getElementById("previewImg");

        if (select.value) {
            img.src = "/img/" + select.value;
        } else {
            img.src = "/img/default-avatar.png";
        }
    }
</script>
