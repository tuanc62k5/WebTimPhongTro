@model DoAn.Models.tblTaiKhoan

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Xóa tài khoản";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h2 class="text-danger">
            <i class="bi bi-trash3-fill"></i> Xóa tài khoản
        </h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"> Tổng quan</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index"> Quản lý tài khoản</a>
                </li>
                <li class="breadcrumb-item active">Xóa</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="card shadow-sm">
            <div class="card-body p-4">

                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    Bạn có chắc chắn muốn xóa tài khoản này không?
                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Mã tài khoản</label>
                        <input class="form-control" value="@Model.TK_ID" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Tên đăng nhập</label>
                        <input class="form-control" value="@Model.TK_TenDangNhap" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Họ và tên</label>
                        <input class="form-control" value="@Model.TK_HoTen" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Email</label>
                        <input class="form-control" value="@Model.TK_Email" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Điện thoại</label>
                        <input class="form-control" value="@Model.TK_DienThoai" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Vai trò</label>
                        <input class="form-control"
                               value="@(Model.TK_VaiTro == "Admin" ? "Quản trị viên" : "Nhân viên")" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Trạng thái</label>
                        <input class="form-control" value="@(Model.TK_TrangThai ? "Hoạt động" : "Bị khóa")" disabled />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">Ngày tạo</label>
                        <input class="form-control" value="@Model.TK_NgayTao.ToString("dd/MM/yyyy HH:mm")" disabled />
                    </div>

                </div>

                <form asp-area="Admin" asp-controller="TaiKhoan" asp-action="Delete" method="post"
                      class="mt-4 text-end">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" value="@Model.TK_ID" />

                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index" class="btn btn-secondary me-2">
                        <i class="bi bi-arrow-left"></i> Quay lại
                    </a>

                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Xác nhận xóa
                    </button>

                </form>

            </div>
        </div>
    </section>

</main>