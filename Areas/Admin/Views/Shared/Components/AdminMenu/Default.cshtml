@using DoAn.Areas.Admin.Models
@model IList<AdminMenu>

<aside id="sidebar" class="sidebar">
    <ul class="sidebar-nav" id="sidebar-nav">

        <li class="nav-item">
            <a class="nav-link" asp-area="Admin" asp-controller="Home" asp-action="Index">
                <i class="bi bi-grid"></i>
                <span>Trang chủ</span>
            </a>
        </li>

        @if (Model != null)
        {
            @foreach (var item in Model
                .Where(m => m.ItemLevel == 1)
                .OrderBy(m => m.ItemOrder))
            {
                var menuId = $"menu-{item.AdminMenuID}";

                var sMenu = Model
                    .Where(p => p.ItemLevel == 2 && p.ParentLevel == item.AdminMenuID)
                    .OrderBy(p => p.ItemOrder)
                    .ToList();

                <li class="nav-item">
                    <a class="nav-link collapsed" data-bs-toggle="collapse" data-bs-target="#@menuId" href="#@menuId"
                       aria-expanded="false" aria-controls="@menuId">
                        <i class="@item.Icon"></i>
                        <span>@item.ItemName</span>

                        @if (sMenu.Any())
                        {
                            <i class="bi bi-chevron-down ms-auto"></i>
                        }
                    </a>

                    @if (sMenu.Any())
                    {
                        <ul id="@menuId" class="nav-content collapse" data-bs-parent="#sidebar-nav">

                            @foreach (var smn in sMenu)
                            {
                                <li>
                                    <a asp-area="@smn.AreaName" asp-controller="@smn.ControllerName" asp-action="@smn.ActionName">
                                        <i class="bi bi-circle"></i>
                                        <span>@smn.ItemName</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                </li>
            }
        }
    </ul>
</aside>
