@model DoAn.Models.tblKhuVuc

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">
    <div class="pagetitle">
        <h2 class="text-danger">
            <i class="bi bi-trash3"></i> Xóa khu vực
        </h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"> Tổng quan</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="TaiKhoan" asp-action="Index"> Quản lý khu vực</a>
                </li>
                <li class="breadcrumb-item active">Xóa</li>
            </ol>
        </nav>
    </div>
    <section class="section">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="KV_ID" />
                    <div class="row g-3">

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Khu vực</label>
                            <input type="text" class="form-control" value="@Model.KV_TenKhuVuc" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tỉnh thành</label>
                            <input type="text" class="form-control" value="@Model.KV_TinhThanh" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Phường xã</label>
                            <input type="text" class="form-control" value="@Model.KV_PhuongXa" readonly />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold">Ngày tạo</label>
                            <input type="text" class="form-control" value="@Model.KV_NgayTao" readonly />
                        </div>

                        <div class="col-md-12">
                            <label class="form-label fw-bold">Địa chỉ chi tiết</label>
                            <input type="text" class="form-control" value="@Model.KV_DiaChiChiTiet" readonly />
                        </div>

                    </div>
                    <div class="text-end mt-4">
                        <a asp-action="Index" class="btn btn-secondary me-2">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash"></i> Xác nhận xóa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</main>