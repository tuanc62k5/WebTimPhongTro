@using DoAn.Models;
@model IList<tblKhuVuc>

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h2 class="text-dark">Danh sách khu vực</h2>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index"> Tổng quan</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="KhuVuc" asp-action="Index"> Quản lý khu vực</a>
                </li>
            </ol>
        </nav>
    </div>

    <div class="mb-3">
        <a class="btn btn-success" asp-area="Admin" asp-controller="KhuVuc" asp-action="Create">
            <i class="bi bi-plus-circle"></i> Thêm mới khu vực
        </a>
    </div>

    
    <form method="get" asp-area="Admin" asp-controller="KhuVuc" asp-action="Index"
          class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex gap-3">

            <select name="tinhThanh" id="tinhThanh" class="form-select" style="width: 200px;">
                <option value="">-- Tất cả tỉnh thành --</option>

                @foreach (var tinh in ViewBag.TinhThanhs)
                {
                    <option value="@tinh" selected="@(ViewBag.TinhThanh?.ToString() == tinh.ToString())">@tinh</option>
                }
            </select>

            <select name="phuongXa" id="phuongXa" class="form-select" style="width: 200px;"
                    disabled="@(string.IsNullOrEmpty(ViewBag.TinhThanh?.ToString()))">

                <option value="">-- Tất cả phường xã --</option>

                @foreach (var phuong in ViewBag.PhuongXaData)
                {
                    <option value="@phuong.KV_PhuongXa" data-tinh="@phuong.KV_TinhThanh"
                            selected="@(ViewBag.PhuongXa?.ToString() == phuong.KV_PhuongXa.ToString())">@phuong.KV_PhuongXa
                    </option>
                }
            </select>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel"></i> Lọc
            </button>

            <a asp-area="Admin" asp-controller="KhuVuc" asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-counterclockwise"></i> Làm mới
            </a>

        </div>

        <div>
            <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control"
                   placeholder="Tìm tên khu vực, tỉnh thành..." style="width: 280px;" />
        </div>

    </form>

    <section class="section">
        <div class="card">
            <div class="card-body pt-4">

                <table class="table table-bordered table-hover align-middle text-center">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">#</th>
                            <th class="text-center">Tên khu vực</th>
                            <th class="text-center">Tỉnh thành</th>
                            <th class="text-center">Phường xã</th>
                            <th class="text-center">Địa chỉ chi tiết</th>
                            <th class="text-center">Ngày tạo</th>
                            <th class="text-center">Chức năng</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.KV_ID</td>
                                <td class="text-left fw-bold"> @item.KV_TenKhuVuc</td>
                                <td>@item.KV_TinhThanh</td>
                                <td>@item.KV_PhuongXa</td>
                                <td>@item.KV_DiaChiChiTiet</td>
                                <td>@item.KV_NgayTao</td>
                                <td class="text-center" scope="row">
                                    <a asp-area="Admin" asp-controller="KhuVuc" asp-action="Edit" asp-route-id="@item.KV_ID"
                                       class="btn btn-primary btn-sm" title="Sửa khu vực"><i class="bi bi-pencil"></i></a>
                                    <a asp-area="Admin" asp-controller="KhuVuc" asp-action="Delete"
                                       asp-route-id="@item.KV_ID" class="btn btn-danger btn-sm" title="Xóa khu vực"><i
                                        class="bi bi-trash"></i></a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                </div>
            </div>
        </section>

    </main>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tinhThanh = document.getElementById("tinhThanh");
            const phuongXa = document.getElementById("phuongXa");

            function locPhuongXa(reset = false) {
                const tinhDuocChon = tinhThanh.value;

                if (reset) {
                    phuongXa.value = "";
                }

                phuongXa.disabled = tinhDuocChon === "";

                Array.from(phuongXa.options).forEach(option => {
                    if (option.value === "") {
                        option.hidden = false;
                        return;
                    }

                    option.hidden = option.dataset.tinh !== tinhDuocChon;
                });

                if (phuongXa.selectedOptions[0]?.hidden) {
                    phuongXa.value = "";
                }
            }

            tinhThanh.addEventListener("change", function () {
                locPhuongXa(true);
            });

            locPhuongXa(false);
        });
    </script>
