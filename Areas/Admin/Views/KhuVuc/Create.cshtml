
@model DoAn.Models.tblKhuVuc

@{
    ViewData["Title"] = "Thêm khu vực";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<main id="main" class="main">

    <div class="pagetitle">
        <h1>Thêm khu vực</h1>
        <nav>
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index">
                        Trang chủ
                    </a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-area="Admin" asp-controller="KhuVuc" asp-action="Index">
                        Quản lý khu vực
                    </a>
                </li>
                <li class="breadcrumb-item active">Thêm mới</li>
            </ol>
        </nav>
    </div>

    <section class="section">
        <div class="row justify-content-center">
            <div class="col-12 col-xl-9 col-xxl-8">

                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4 p-lg-5">

                        <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                            <div class="rounded-3 bg-primary bg-opacity-10 text-primary
                                        d-flex align-items-center justify-content-center me-3"
                                 style="width: 48px; height: 48px;">
                                <i class="bi bi-geo-alt fs-4"></i>
                            </div>

                            <div>
                                <h5 class="mb-1 fw-bold">Thông tin khu vực</h5>
                                <p class="text-muted small mb-0">
                                </p>
                            </div>
                        </div>

                        @if (ViewBag.Error != null)
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-circle me-2"></i>
                                @ViewBag.Error
                            </div>
                        }

                        <form asp-area="Admin"
                              asp-controller="KhuVuc"
                              asp-action="Create"
                              method="post">

                            @Html.AntiForgeryToken()

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"></div>

                            <div class="row g-4">

                                <div class="col-6">
                                    <label asp-for="KV_TenKhuVuc"
                                           class="form-label fw-semibold">
                                        Tên khu vực <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="KV_TenKhuVuc"
                                           class="form-control"
                                           placeholder="Ví dụ: Khu vực trung tâm TP Vinh"
                                           required />
                                    <span asp-validation-for="KV_TenKhuVuc"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-md-6">
                                    <label asp-for="KV_TinhThanh"
                                           class="form-label fw-semibold">
                                        Tỉnh / Thành phố <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="KV_TinhThanh"
                                           class="form-control"
                                           placeholder="Ví dụ: Nghệ An"
                                           required />
                                    <span asp-validation-for="KV_TinhThanh"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-6">
                                    <label asp-for="KV_PhuongXa"
                                           class="form-label fw-semibold">
                                        Phường / Xã <span class="text-danger">*</span>
                                    </label>
                                    <input asp-for="KV_PhuongXa"
                                           class="form-control"
                                           placeholder="Nhập tên phường hoặc xã"
                                           required />
                                    <span asp-validation-for="KV_PhuongXa"
                                          class="text-danger small"></span>
                                </div>

                                <div class="col-12">
                                    <label asp-for="KV_DiaChiChiTiet"
                                           class="form-label fw-semibold">
                                        Địa chỉ chi tiết
                                    </label>
                                    <textarea asp-for="KV_DiaChiChiTiet"
                                              class="form-control"
                                              rows="4"
                                              placeholder="Nhập địa chỉ hoặc mô tả vị trí khu vực"></textarea>
                                    <span asp-validation-for="KV_DiaChiChiTiet"
                                          class="text-danger small"></span>
                                </div>

                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                                <a asp-area="Admin"
                                   asp-controller="KhuVuc"
                                   asp-action="Index"
                                   class="btn btn-light border px-4">
                                    <i class="bi bi-arrow-left me-1"></i>
                                    Quay lại
                                </a>

                                <button type="submit" class="btn btn-primary px-4">
                                    <i class="bi bi-check2-circle me-1"></i>
                                    Lưu khu vực
                                </button>
                            </div>

                        </form>

                    </div>
                </div>

            </div>
        </div>
    </section>

</main>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}