<!doctype html>
<html lang="en">
<head>
  <script>document.documentElement.classList.add('js')</script>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cornerstone — Full-Service Property Management for Owners & Renters</title>
  <meta name="description" content="Cornerstone manages single-family homes, condos and small multifamily buildings — tenant screening, rent collection, 24/7 maintenance and transparent owner reporting. Get a free rental analysis.">
  <meta name="theme-color" content="#123b2e">
  <meta property="og:title" content="Cornerstone Property Management">
  <meta property="og:description" content="Full-service residential property management for owners and renters. Get a free rental analysis today.">
  <meta property="og:type" content="website">
  <meta property="og:image" content="img/og-cornerstone.jpg">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="css/vendor/bootstrap.min.css">
  <link rel="stylesheet" href="css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>

  <!-- ===================== HEADER ===================== -->
    @await Component.InvokeAsync("MenuView")

    <!-- Main Start -->
    @RenderBody()
    <!-- Main End -->

  <!-- ===================== FOOTER ===================== -->
