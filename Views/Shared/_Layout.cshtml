          <a href="#instagram" aria-label="Cornerstone on Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg></a>
          <a href="#linkedin" aria-label="Cornerstone on LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 5 8.5a2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05a4.2 4.2 0 0 1 3.75-2C20.3 8.7 21 11 21 14v7h-4v-6.2c0-1.5 0-3.4-2-3.4s-2.4 1.6-2.4 3.3V21H9z"/></svg></a>
        </div>
      </div>
    </div>
  </footer>

  <script src="js/vendor/bootstrap.bundle.min.js"></script>
  <script src="js/main.js"></script>
</body>
</html>
